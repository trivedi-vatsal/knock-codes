{
  "name": "knock-codes",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run generate && vite --host 0.0.0.0",
    "build": "npm run generate && tsc --noEmit && npm run check:examples && vite build && tsx scripts/site-pages.ts",
    "test": "tsx --test tests/*.test.tsx",
    "generate": "tsx scripts/generate.ts",
    "check:generated": "tsx scripts/generate.ts --check",
    "check:registry": "shadcn registry validate",
    "check:examples": "tsc --noEmit -p .generated/tsconfig.json",
    "test:install": "tsx scripts/install-smoke.ts",
    "format:check": "prettier --check registry src scripts tests vite.config.ts",
    "check": "npm run check:generated && npm run check:registry && npm run build && npm test",
    "test:react18": "tsx scripts/react18-check.ts",
    "test:pages": "tsx scripts/pages-check.ts",
    "test:docs": "tsx scripts/docs-check.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "axe-core": "^4.10.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
